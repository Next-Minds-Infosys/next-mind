# Copy to `.env` and fill in real values. `.env*` is gitignored - never commit secrets.

# ---- Database (Sequelize) ----------------------------------------------------
# Required. Without it the app falls back to a placeholder connection string so
# `next build` still succeeds, but every query will fail at runtime.
# Matches docker-compose.yml (`docker compose up -d postgres`):
DATABASE_URL=postgres://next_mind:next_mind@127.0.0.1:5434/next_mind

# ---- Public site URL ---------------------------------------------------------
# Canonical origin used by sitemap.xml and robots.txt. Must be the domain users
# actually visit - a localhost value here would publish localhost URLs to search
# engines. Defaults to https://www.nextmindsinfosys.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.nextmindsinfosys.com

# ---- Database TLS ------------------------------------------------------------
# Certificates are VERIFIED by default. Neon, RDS and most managed Postgres
# chain to roots already in Node's trust store, so neither variable below is
# normally needed.
#
# DATABASE_CA_CERT   pin a specific CA, for a provider using a private root.
# DATABASE_SSL_INSECURE=true  skip verification entirely. Last resort - it
#                    leaves the connection open to an active man-in-the-middle.
#
# Note: `?sslmode=` and `?channel_binding=` are stripped from DATABASE_URL
# before it reaches the driver (we set TLS explicitly), so leaving them on the
# URL is harmless.
DATABASE_CA_CERT=
DATABASE_SSL_INSECURE=

# ---- Analytics ---------------------------------------------------------------
# Google Tag Manager container. Defaults to the production container, so leave
# it unset in production. Set it to an empty string locally to keep development
# traffic out of your analytics.
NEXT_PUBLIC_GTM_ID=

# ---- Auth (better-auth) ------------------------------------------------------
# Required. Without it better-auth falls back to a default secret and logs
# "You are using the default secret" on every build/boot.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of this app. Without it callbacks/redirects are derived from the
# incoming request and may be wrong.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional - GitHub social login. Leave blank to disable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Outbound mail (nodemailer, Gmail service) -------------------------------
# Used by the contact / enroll / enterprise API routes.
# SMTP_PASS must be a Google App Password, not the account password.
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# ---- Seed users (src/db/seed.ts) ----------------------------------------------
# Admin is required by the seed script; instructor/student are optional - if
# unset, the script falls back to instructor@nextmindsinfosys.com /
# Instructor@123 and student@nextmindsinfosys.com / Student@123, and also
# creates a "TEST-BATCH-01" batch linking the two so both logins land on a
# populated dashboard instead of an empty one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
INSTRUCTOR_EMAIL=
INSTRUCTOR_PASSWORD=
STUDENT_EMAIL=
STUDENT_PASSWORD=

# ---- File storage (AWS S3) ---------------------------------------------------
# The bucket MUST block all public access. Files are only ever reachable through
# a short-lived presigned URL minted by /api/media after a batch-membership check.
# CORS on the bucket must allow PUT from your app origin for direct uploads.
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Error tracking (Sentry) -------------------------------------------------
# Optional. Everything stays inert without a DSN, so leaving these blank keeps
# the previous behaviour. Set them in Vercel to start receiving production
# errors instead of discovering them in the logs.
#   SENTRY_DSN             server-side only, never exposed to the browser
#   NEXT_PUBLIC_SENTRY_DSN browser-side; safe to expose, it is write-only
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
